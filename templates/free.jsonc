{
  "$schema": "https://opencode.ai/config.json",
  // opencode-free-router: loaded via OPENCODE_CONFIG by the `opencode-free` wrapper (and the bb agent),
  // merged over your normal opencode config, so plain `opencode` is unaffected.
  // free/auto is a placeholder: plugin.js swaps it for the best-ranked free model on every turn
  // (sticky per session) and fails over when that model runs out. See ranking.json / rank.mjs.
  "plugin": ["./plugin.js"],
  "model": "free/auto",
  "provider": {
    // Never called: the dead baseURL makes a missed rewrite fail fast instead of
    // silently landing on some other (possibly paid) model.
    "free": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Free (auto-ranked)",
      "options": {
        "baseURL": "http://127.0.0.1:9/v1",
        "apiKey": "unused"
      },
      "models": {
        "auto": {
          "name": "Best available free model",
          "tool_call": true,
          "limit": {
            "context": 200000,
            "output": 32000
          }
        }
      }
    }
  }
}
