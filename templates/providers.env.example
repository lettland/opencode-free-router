# Provider keys for the opencode-free wrapper (and the bb agent). Exported into opencode.
# Optional: keys you already have via `opencode auth login` or your shell work without this file.
# Use FREE-PLAN accounts only. Groq, Cerebras and Google models count as free because
# of their free tier; a key with billing enabled may be charged.
# Leave a line commented out to keep that provider out of the pool.
#
# OPENROUTER_API_KEY=             # https://openrouter.ai/keys (only :free models are used)
# GROQ_API_KEY=                   # https://console.groq.com/keys
# CEREBRAS_API_KEY=               # https://cloud.cerebras.ai
# GOOGLE_GENERATIVE_AI_API_KEY=   # https://aistudio.google.com/apikey (project without billing)
# NVIDIA_API_KEY=                 # https://build.nvidia.com (free, rate-limited; only 0-priced models are used)
